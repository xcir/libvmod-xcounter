vtest "Test xcounter vmod(hide/reveal)"

server s1 -repeat 2 {
       rxreq
       txresp
} -start

vcache v1 -arg "-p vcl_cooldown=1" -vcl+backend {
	import ${vmod_xcounter};

	sub vcl_init {
		new xc = xcounter.vsc();
	}

	sub vcl_deliver {
		xc.set(10);
	}

} -start

vcache v1 -vcl+backend {
	import ${vmod_xcounter};

	sub vcl_init {
		new xc = xcounter.vsc();
	}
	sub vcl_deliver {
		xc.set(10);
	}
}

delay .4
vcache v1 -cliok "vcl.state vcl1 cold"
delay 1.4

client c1 {
	txreq -url "/"
	rxresp
} -run

vcache v1 -expect !XCNT.vcl1.xc.val
vcache v1 -expect  XCNT.vcl2.xc.val == 10


vcache v1 -cliok "vcl.state vcl1 auto"
vcache v1 -cliok "vcl.use vcl1"
delay .4

vcache v1 -expect XCNT.vcl1.xc.val == 0
vcache v1 -expect XCNT.vcl2.xc.val == 10


